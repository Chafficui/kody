{
  "name": "@kody/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "CLI companion for the Kody self-hosted AI chat widget. Scaffolds a working server with `init`, checks it with `doctor`, and exposes tool testing via `tools test`.",
  "bin": {
    "kody": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "pretest": "tsc --build tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@kody/shared": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
