{
  "name": "@kody/widget",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/kody.js",
  "types": "./dist/kody.d.ts",
  "exports": {
    ".": {
      "types": "./dist/kody.d.ts",
      "import": "./dist/kody.esm.js",
      "require": "./dist/kody.umd.js",
      "default": "./dist/kody.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/stamp-types.mjs",
    "build:bundle": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "happy-dom": "^20.8.9",
    "jsdom": "^26.0.0",
    "terser": "^5.46.2",
    "typescript": "~5.8.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "marked": "^18.0.2"
  },
  "peerDependencies": {
    "@kody/shared": "workspace:*"
  }
}
